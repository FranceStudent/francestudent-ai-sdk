{
	"name": "francestudent-ai-sdk",
	"version": "0.1.0",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"description": "An unofficial SDK and CLI for the FranceStudent AI API (api.francestudent.ai).",
	"bin": {
		"fsai": "dist/cli.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc",
		"prepare": "tsc",
		"test": "tsc && node --test test/*.test.js",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint --max-warnings 0 --fix .",
		"lint:check": "eslint --max-warnings 0 .",
		"docs": "typedoc --excludePrivate --excludeProtected --excludeInternal src/index.ts"
	},
	"keywords": [
		"francestudent",
		"api",
		"sdk",
		"cli",
		"ai"
	],
	"author": {
		"name": "LekkereLou"
	},
	"license": "ISC",
	"engines": {
		"node": "^22.21.0 || ^24.0.0"
	},
	"dependencies": {
		"axios": "^1.20.0",
		"commander": "^15.0.0",
		"http-proxy-agent": "^9.1.0",
		"https-proxy-agent": "^9.1.0",
		"socks-proxy-agent": "^10.1.0"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.7",
		"@types/node": "^22.20.5",
		"@typescript-eslint/eslint-plugin": "^8.71.2",
		"@typescript-eslint/parser": "^8.71.2",
		"eslint": "^9.39.5",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-tsdoc": "^0.5.4",
		"prettier": "^3.9.10",
		"typedoc": "^0.28.20",
		"typescript": "^5.9.3"
	}
}
